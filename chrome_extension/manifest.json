{
  "manifest_version": 3,
  "name": "AI Live Director Taobao Connector",
  "version": "0.1.1",
  "description": "Captures Taobao live assistant metric responses and sends normalized metrics to the local AI Live Director.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "action": {
    "default_title": "AI Live Copilot",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://ai-live-commerce-copilot.onrender.com/*",
    "*://liveplatform.taobao.com/*",
    "*://*.taobao.com/*",
    "*://*.tmall.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "*://liveplatform.taobao.com/*",
        "*://*.taobao.com/*",
        "*://*.tmall.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page_hook.js"],
      "matches": [
        "<all_urls>",
        "*://liveplatform.taobao.com/*",
        "*://*.taobao.com/*",
        "*://*.tmall.com/*"
      ]
    }
  ]
}
